{
  "name": "giftcode-hub",
  "description": "Collect public gift codes daily and redeem them from a browser extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare",
    "browser": "node scripts/browser.ts",
    "capture": "node scripts/capture.ts",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "e2e": "node scripts/e2e.ts",
    "scrape": "node scripts/scrape/index.ts",
    "gen:df-messages": "node scripts/gen-df-messages.ts",
    "gen:icons": "node scripts/gen-icons.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.4",
    "@wxt-dev/module-svelte": "^2.0.4",
    "cheerio": "^1.2.0",
    "playwright": "^1.63.0",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.4",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0"
  },
  "packageManager": "pnpm@12.6.0"
}
